rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
    
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
        (request.auth.token.email == 'chavdalucky168@gmail.com' || request.auth.token.email == 'Rahulrparmar307@gmail.com');
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /phone_to_email/{phone} { allow read: if true; allow write: if isSignedIn(); }
    match /email_to_phone/{email} { allow read: if true; allow write: if isSignedIn(); }
    
    match /activity_logs/{logId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || resource.data.userId == 'all' || isAdmin());
      allow create: if true;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || resource.data.userId == 'all' || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }
    match /fcm_tokens/{tokenId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /services/{serviceId} { allow read: if true; allow write: if isAdmin(); }
    match /reviews/{reviewId} { allow read: if true; allow create: if true; allow update, delete: if isAdmin(); }
    match /transformations/{transformationId} { allow read: if true; allow create: if true; allow update, delete: if isAdmin(); }
    match /gallery/{imageId} { allow read: if true; allow write: if isAdmin(); }
    match /galleryCategories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /loyaltySettings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /systemSettings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /rewardHistory/{document=**} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /bookings/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notification_logs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ai_chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
